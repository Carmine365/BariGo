~ start

# CONTROLLO PREVENTIVO: Se l'albero dei flag è interamente vero, usciamo subito
if global.info_margherita and global.info_team and global.info_petruzzelli and global.info_kismet and global.info_forma and global.info_piccinni:
	Signora delle Sgagliozze: Uagliò, ho raschiato il fondo, è finita la polenta e sono finite pure le storie! Inutile che mi guardi, vai a farti un giro in città!
	=> END

Signora delle Sgagliozze: Uagliò, l'olio sfrigola e la farina costa! 
Signora delle Sgagliozze: Portami 4 monete. Ti do un cartoccio di sgagliozze bollenti e, mentre mangi, ti racconto un segreto su questi teatri che sui libri dell'università non trovi.

- Player: Tenga le monete, signora!
	=> controllo_monete
- Player: Non ho ancora abbastanza spiccioli, ripasso dopo.
	Signora delle Sgagliozze: Muoviti, che qua la fila si allunga e l'olio si fredda!
	=> END

~ controllo_monete

# Controllo matematico sull'inventario
if global.coin >= 4:
	Signora delle Sgagliozze: Le monete ci sono. Di quale teatro vuoi conoscere il segreto?
	
	# Il menu mostra solo le opzioni con flag "false"
	- Teatro Margherita [if global.info_margherita == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Tieni il cartoccio, attento che scotta. Hai visto che strano quel teatro piantato in mezzo all'acqua? Non è per romanticismo, uagliò. 
		Signora delle Sgagliozze: Nel 1914 c'era un patto col Comune: nessuno poteva costruire teatri in muratura sulla terraferma per non fare concorrenza al Petruzzelli. 
		Signora delle Sgagliozze: E sai la famiglia Messeni Nemagna che s'inventò? Lo costruirono direttamente sul mare, appoggiato sulle palafitte! Aggirata la legge, fregata la concorrenza. 
		Signora delle Sgagliozze: È l'unico in tutta Europa fatto così. Oggi ci fanno l'arte contemporanea, ma la furbizia barese non passa mai di moda.
		set global.info_margherita = true
		do global.aggiungi_appunto("Teatro Margherita", "Costruito nel 1914 interamente su palafitte in mare per aggirare il divieto di edificare sulla terraferma, eludendo la concorrenza al Petruzzelli. Unico in Europa.")
		=> END
	
	- Teatro Team [if global.info_team == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Sgagliozze belle calde per te. Senti questa, che quel direttore là non te la dice. 
		Signora delle Sgagliozze: Lo sai qual è stato il record vero di questo posto? Anno 1996, Lino Banfi porta il suo spettacolo qua.
		Signora delle Sgagliozze: Ventuno giorni. Ventuno giorni di fila di tutto esaurito! Un record assoluto per tutto il Sud Italia. Non si trovava un biglietto manco a pagarlo a peso d'oro, una cosa mai vista!
		set global.info_team = true
		do global.aggiungi_appunto("Teatro Team", "Nel 1996 ha registrato 21 giorni consecutivi di tutto esaurito per lo spettacolo di Lino Banfi, un record assoluto per il Sud Italia.")
		=> END
		
	- Teatro Petruzzelli [if global.info_petruzzelli == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Prendi 'sto cartoccio, mangia che devi crescere. Hai visto quel pompiere disperato? 
		Signora delle Sgagliozze: Quella è una ferita che a Bari non si chiude. Era la notte tra il 26 e il 27 ottobre del 1991. Qualcuno ha dato fuoco al teatro di proposito. Un incendio doloso.
		Signora delle Sgagliozze: Le fiamme erano così alte che illuminavano la città. La cupola bellissima è crollata in pezzi. Per quasi vent'anni, a causa di cause legali e burocrazia, è rimasto un cantiere a cielo aperto.
		Signora delle Sgagliozze: Ha riaperto solo nel 2009. Ce l'abbiamo fatta a ricostruirlo, ma chi c'era quella notte, le sirene dei pompieri non se le scorda più.
		set global.info_petruzzelli = true
		do global.aggiungi_appunto("Teatro Petruzzelli", "Distrutto da un incendio doloso nell'ottobre 1991. Dopo il crollo della cupola e complesse vicende burocratiche, è stato ricostruito e riaperto solo nel 2009.")
		=> END
		
	- Teatro Kismet [if global.info_kismet == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Tieni, sgagliozze calde. Devi sapere che il Kismet è nato nel 1981 in un capannone industriale.
		Signora delle Sgagliozze: Dal cemento all'arte. Prima ci facevano i lavori pesanti, mo è la casa del teatro contemporaneo. Una bella rivoluzione.
		set global.info_kismet = true
		do global.aggiungi_appunto("Teatro Kismet", "Fondato nel 1981 all'interno di un ex capannone industriale, è diventato il punto di riferimento per il teatro contemporaneo barese.")
		=> END

	- Teatro Forma [if global.info_forma == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Brucia, eh? Soffia e ascolta. Hai visto quel teatro nascosto sotto terra dai Salesiani? Quello è un ragazzino, ha aperto solo nel 2010. 
		Signora delle Sgagliozze: È la struttura più moderna che abbiamo, ma la vera magia non si vede: è rivestito con dei legni speciali studiati apposta per curare l'acustica. 
		Signora delle Sgagliozze: Lì dentro la musica non rimbomba, ti accarezza le orecchie. Ci vanno i grandi artisti jazz proprio per quello. Moderno sì, ma fatto con la testa.
		set global.info_forma = true
		do global.aggiungi_appunto("Teatro Forma", "Inaugurato nel 2010 sotto l'Istituto Salesiano. È la struttura più moderna del percorso, progettata con legni specifici per isolare e massimizzare la resa acustica, diventando un punto di riferimento per il jazz.")
		=> END
		
	- Teatro Piccinni [if global.info_piccinni == false]
		set global.coin = global.coin - 4
		do global.play_suono_successo()
		Signora delle Sgagliozze: Ascolta a me, questo è il nonno di tutti quanti: il Teatro Piccinni. È il più antico di Bari, ha aperto i battenti nel 1854!
		Signora delle Sgagliozze: Pensa un po', lo ha progettato un architetto famoso, Antonio Niccolini, prima ancora che l'Italia fosse unita. Ci cantavano le opere quando c'erano ancora i Borbone.
		Signora delle Sgagliozze: Ha rischiato grosso, ma per fortuna si sono decisi e nel 2019 hanno finito un restauro che lo ha salvato. 'Na bomboniera.
		set global.info_piccinni = true
		do global.aggiungi_appunto("Teatro Piccinni", "Il più antico di Bari (1854), progettato da Antonio Niccolini in epoca pre-unitaria. È tornato al suo antico splendore grazie a un profondo restauro concluso nel 2019.")
		=> END

	- Ho cambiato idea, tengo le mie monete.
		Signora delle Sgagliozze: E allora non mi far perdere tempo, l'olio si brucia!
		=> END
		

else:
	do global.play_suono_fallimento()
	Signora delle Sgagliozze: Che ci faccio con {{global.coin}} monete? Non ci pago manco la carta del cartoccio. Ne servono 4, torna quando hai gli spiccioli giusti.
	=> END